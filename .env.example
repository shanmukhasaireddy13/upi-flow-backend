# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (the Next.js app)
FRONTEND_ORIGINS=http://localhost:3000
# Base URL of the hosted checkout pages, used in checkout_url
CHECKOUT_BASE_URL=http://localhost:3000
# Set true only when the server is behind a reverse proxy
TRUST_PROXY=false

# ---- Database (Supabase) ----
# Use the service role key on the server. Never expose it to the browser.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-key

# ---- Sessions ----
# Long random string. Required so logins survive restarts.
SESSION_SECRET=replace-with-a-long-random-string

# ---- Ingestion ----
# Shared secret for trusted email forwarders calling /api/webhooks/email. Leave empty to disable.
GATEWAY_SECRET=replace-with-a-long-random-string
# Token that must appear as ?token=... on the Pub/Sub push subscription URL
PUBSUB_VERIFICATION_TOKEN=replace-with-a-long-random-string

# ---- Google (Gmail verification) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications

# ---- Development only ----
# Enables POST /api/webhooks/mock-payment. Never set this in production.
ALLOW_SIMULATION=false

# ---- Optional: IMAP IDLE ----
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
