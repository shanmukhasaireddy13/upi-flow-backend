# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (the Next.js app)
FRONTEND_ORIGINS=http://localhost:3000
# Optional regex for your own Vercel preview URLs. Never allow all of *.vercel.app.
PREVIEW_ORIGIN_PATTERN=
# Base URL of the hosted checkout pages, used in checkout_url
CHECKOUT_BASE_URL=http://localhost:3000
# Set true only when the server is behind a reverse proxy
TRUST_PROXY=false

# ---- Database (Supabase) ----
# The server must use the service role key (Project Settings > API). Never expose it to the browser.
# After switching, run migrations/002_lock_down_rls.sql so the public anon key cannot read any table.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Sessions ----
# Long random string. Required so logins survive restarts.
SESSION_SECRET=replace-with-a-long-random-string

# ---- Ingestion ----
# Shared secret for trusted email forwarders calling /api/webhooks/email. Leave empty to disable.
GATEWAY_SECRET=replace-with-a-long-random-string
# Pub/Sub push requests must carry ONE of these:
#  - ?token=... on the push subscription URL, equal to PUBSUB_VERIFICATION_TOKEN
#  - a Google-signed OIDC token (enable authentication on the push subscription), whose audience
#    is PUBSUB_AUDIENCE and whose service account is PUBSUB_SERVICE_ACCOUNT
PUBSUB_VERIFICATION_TOKEN=replace-with-a-long-random-string
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# ---- Google (Gmail verification) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications

# ---- Receipt sender check ----
# Payment emails are accepted only when Gmail's Authentication-Results shows DKIM or DMARC pass for these domains.
RECEIPT_SENDER_DOMAINS=famapp.in

# ---- Development only ----
# Enables POST /api/webhooks/mock-payment. Never set this in production.
ALLOW_SIMULATION=false

# ---- Optional: IMAP IDLE ----
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
